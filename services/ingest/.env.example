# ── Shared ────────────────────────────────────────────────────────────────
# Redis pub/sub bus the publisher writes filing:new events to.
REDIS_URL=redis://localhost:6379/0

# ── services/ingest ───────────────────────────────────────────────────────
SEC_USER_AGENT=Your Name your@email.com
# Comma-separated list of Groq API keys for round-robin rotation.
# Falls back to GROQ_API_KEY (singular) if not set.
GROQ_API_KEYS=
GROQ_API_KEY=

# ── Press-release ingestion (press_release/) ─────────────────────────────
# Off by default. Before enabling in a new environment, validate the wire
# feeds with: PYTHONPATH=. python tools/probe_pr_feeds.py
PR_INGEST_ENABLED=0
# Seconds between wire polls (min 60, default 180)
PR_POLL_INTERVAL=180
# User-Agent for newswire requests (NOT the SEC one)
PR_USER_AGENT=Mozilla/5.0 (compatible; SensybullFeedReader/1.0)
# Per-wire feed URL overrides (comma-separated), e.g.:
# PR_FEED_URLS_GLOBENEWSWIRE=
# PR_FEED_URLS_PRNEWSWIRE=
# PR_FEED_URLS_BUSINESSWIRE=
# PR_FEED_URLS_ACCESSWIRE=
