# ── Shared ────────────────────────────────────────────────────────────────
# Redis pub/sub bus the publisher writes filing:new events to.
REDIS_URL=redis://localhost:6379/0

# ── services/ingest ───────────────────────────────────────────────────────
SEC_USER_AGENT=Your Name your@email.com
# Comma-separated list of Groq API keys for round-robin rotation.
# Falls back to GROQ_API_KEY (singular) if not set.
GROQ_API_KEYS=
GROQ_API_KEY=
# Optional: override the model fallback chain (comma-separated, best-first).
# Leave unset to use the built-in default. Handy when Groq retires a model.
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.6-27b

# ── Press-release ingestion (press_release/) ─────────────────────────────
# Always on. Check a new environment's FMP key and gates with:
#   PYTHONPATH=. python tools/probe_fmp_press_releases.py --gates
# FMP source (the default): seconds between polls
PR_FMP_POLL_SECONDS=1
# PR_SOURCE=rss only: seconds between wire RSS polls (min 60, default 180)
# PR_POLL_INTERVAL=180
# User-Agent for newswire requests (NOT the SEC one)
PR_USER_AGENT=Mozilla/5.0 (compatible; SensybullFeedReader/1.0)
# Per-wire feed URL overrides (comma-separated). Business Wire and
# Accesswire ship with NO default URL (no confirmed public RSS) and stay
# off until one is provided here:
# PR_FEED_URLS_GLOBENEWSWIRE=
# PR_FEED_URLS_PRNEWSWIRE=
# PR_FEED_URLS_BUSINESSWIRE=
# PR_FEED_URLS_ACCESSWIRE=
